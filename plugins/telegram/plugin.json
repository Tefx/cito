{
  "id": "telegram",
  "kind": "human-channel",
  "displayName": "Telegram",
  "tier": "stable",
  "scope": "hub",
  "sfSymbol": "paperplane.fill",
  "tint": "blue",
  "cliFlag": false,
  "command": [
    "./bin/cito-plugin-telegram"
  ],
  "supportsOutboundOnly": true,
  "serviceActions": {
    "save": "Save Gateway Token",
    "change": "Change Token…",
    "clear": "Clear Token"
  },
  "serviceIdentity": { "field": "botToken", "separator": ":" },
  "fields": [
    {
      "key": "botToken",
      "scope": "hub",
      "label": "Bot Token",
      "type": "secret",
      "required": true,
      "placeholder": "123456:ABC-DEF…",
      "configuredPlaceholder": "•••••••• (Saved — enter new token to replace)",
      "helpText": "Shared once for everyone on this Hub"
    },
    {
      "key": "chatId",
      "scope": "user",
      "label": "Chat ID",
      "type": "string",
      "required": true,
      "placeholder": "Paired via /start or enter Chat ID",
      "helpText": "Destination for your personal notifications"
    }
  ],
  "pairing": {
    "supported": true,
    "manualDisclosure": true,
    "openUrlLabel": "Open in Telegram ↗",
    "privateIdentityField": "chatId",
    "deliveryVerificationHelpText": "Send /start to the bot or re-pair your account to verify delivery.",
    "actionLabel": "Pair Account…",
    "helpText": "Generate a one-time /start code to link your Telegram chat (expires in 10 minutes)."
  },
  "version": "0.23.0",
  "setupGuide": [
    "Create a bot via @BotFather (/newbot) on Telegram and paste its token:"
  ]
}
