  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jose": "^6.1.3",
    "zod": "^4.6.7"
