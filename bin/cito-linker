#!/bin/sh
# Cargo's linker hook stages completed release executables after linking.
set -eu
/usr/bin/cc "$@"
# libtest harnesses share Cargo binary prefixes but are never distributable apps.
for arg in "$@"; do
  case "$arg" in *libtest-*) exit 0 ;; esac
done
out=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "-o" ]; then shift; out="$1"; break; fi
  shift
done
case "$out" in */release/deps/*) ;; *) exit 0 ;; esac
# LTO can absorb libtest into an object before this hook sees any archive arguments.
compiler_args="$(/bin/ps -p "$PPID" -o command=)"
case " $compiler_args " in *" --test "*) exit 0 ;; esac
root="$(cd "$(dirname "$0")/.." && pwd)"
name="$(basename "$out")"
case "$name" in
  cito_native-*) dest="$root/bin/cito-native-darwin-arm64" ;;
  cito_plugin_pi-*) dest="$root/plugins/pi/bin/cito-plugin-pi" ;;
  cito_plugin_codex-*) dest="$root/plugins/codex/bin/cito-plugin-codex" ;;
  cito_plugin_claude-*) dest="$root/plugins/claude/bin/cito-plugin-claude" ;;
  cito_claude_hook-*) dest="$root/plugins/claude/bin/cito-claude-hook" ;;
  cito_plugin_telegram-*) dest="$root/plugins/telegram/bin/cito-plugin-telegram" ;;
  *) exit 0 ;;
esac
# Cargo may not have promoted this link to its canonical release path yet.
bin_name="$(printf '%s' "${name%-*}" | tr '_' '-')"
canonical="$(dirname "$(dirname "$out")")/$bin_name"
if [ -f "$canonical" ] && /usr/bin/cmp -s "$out" "$canonical"; then
  out="$canonical"
fi
# Replace atomically so an interrupted link/sign never exposes a partial binary.
mkdir -p "$(dirname "$dest")"
tmp="$dest.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cp "$out" "$tmp"
chmod 755 "$tmp"
if ! codesign_err="$(/usr/bin/codesign --force --sign - "$tmp" 2>&1)"; then
  printf '%s\n' "$codesign_err" >&2
  exit 1
fi
mv -f "$tmp" "$dest"
