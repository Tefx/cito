#!/bin/sh
set -eu
s="$0"
while [ -L "$s" ]; do
  d="$(cd -P "$(dirname "$s")" && pwd)"
  t="$(readlink "$s")"
  case "$t" in /*) s="$t" ;; *) s="$d/$t" ;; esac
done
b="$(cd -P "$(dirname "$s")" && pwd)"
n="$b/cito-native-darwin-arm64"
if [ ! -x "$n" ]; then
  printf '%s\n' 'Cito native binary is missing. Run npm run compile or reinstall the macOS arm64 package.' >&2
  exit 127
fi
export CITO_BUILTIN_PLUGINS_DIR="${CITO_BUILTIN_PLUGINS_DIR:-$b/../plugins}"
export CITO_ENDPOINT_PID="${CITO_ENDPOINT_PID:-$PPID}"
exec "$n" "$@"
