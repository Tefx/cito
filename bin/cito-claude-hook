#!/bin/sh
':' //; s="$0"; while [ -L "$s" ]; do d="$(cd -P "$(dirname "$s")" && pwd)"; t="$(readlink "$s")"; case "$t" in /*) s="$t" ;; *) s="$d/$t" ;; esac; done; b="$(cd -P "$(dirname "$s")" && pwd)"; n="$b/cito-native-darwin-arm64"; if [ "${CITO_DISABLE_NATIVE:-0}" != "1" ] && [ -x "$n" ]; then export CITO_BUILTIN_PLUGINS_DIR="${CITO_BUILTIN_PLUGINS_DIR:-$b/../plugins}"; export CITO_ENDPOINT_PID="${CITO_ENDPOINT_PID:-$PPID}"; exec "$n" hook "$@"; fi; exec "${CITO_NODE_BIN:-node}" "$s" "$@"
import { existsSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const nativeBin = fileURLToPath(new URL("./cito-native-darwin-arm64", import.meta.url));
if (
  process.platform === "darwin" &&
  process.arch === "arm64" &&
  process.env.CITO_DISABLE_NATIVE !== "1" &&
  existsSync(nativeBin)
) {
  const res = spawnSync(nativeBin, ["hook", ...process.argv.slice(2)], {
    stdio: "inherit",
    env: {
      ...process.env,
      CITO_ENDPOINT_PID: process.env.CITO_ENDPOINT_PID ?? String(process.ppid),
    },
  });
  process.exit(res.status ?? 0);
}

const { runEntrypoint } = await import("./loader.js");
try {
  await runEntrypoint("../dist/plugins/claude/hook-cli.js", "../plugins/claude/hook-cli.ts");
} catch (error) {
  process.stderr.write("cito-claude-hook: " + (error instanceof Error ? error.message : String(error)) + "\n");
  process.stdout.write("{}\n");
}
