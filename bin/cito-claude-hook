#!/usr/bin/env node
import { runEntrypoint } from "./loader.js";

try {
  await runEntrypoint("../dist/plugins/claude/hook-cli.js", "../plugins/claude/hook-cli.ts");
} catch (error) {
  process.stderr.write("cito-claude-hook: " + (error instanceof Error ? error.message : String(error)) + "\n");
  process.stdout.write("{}\n");
}
